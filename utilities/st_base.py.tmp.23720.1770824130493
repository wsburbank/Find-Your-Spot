import streamlit as st
import pandas as pd
import numpy as np
import sys
import math


@st.cache_data
def load_stator_data():
    df = pd.read_excel('data/PreAssignmentDataSet_StatorTemp.xlsx', sheet_name='stator_temp_dataset_2018', engine='openpyxl')
    df['timestamp_utc'] = pd.to_datetime(df['timestamp_utc'], utc=True)
    df['datetime_stamp_pacific'] = pd.to_datetime(df['datetime_stamp_pacific'], utc=False).dt.tz_localize('US/Pacific', ambiguous='infer')
    
    gens = ['C-02', 'C-04', 'C-05', 'C-06', 'C-07']
    measures = ['winding_temp(C)', 'total_current(A)', 'cooling_water_flow(gal/min)', 'cooling_water_temp(C)', 'cooling_air_out_temp(C)']
    standalone_sensors = ['river_temp_C']  # Sensors that don't concat with gens

    #  https://public.crohms.org/dd/nwdp/temps/www/
    river_df = pd.read_csv('data/Columbia_River_Temp.csv')
    river_df['Date'] = pd.to_datetime(river_df['Date'], format='%b %d %Y')
    # Convert to float, errors become NaN, then forward fill
    river_df['Avg T (F)'] = pd.to_numeric(river_df['Avg T (F)'], errors='coerce').ffill()
    # Convert Fahrenheit to Celsius: (F - 32) * 5/9
    river_df['river_temp_C'] = (river_df['Avg T (F)'] - 32) * 5 / 9
    river_df = river_df[['Date', 'river_temp_C']]
    river_df = river_df.groupby('Date').first().reset_index()  # Ensure one value per day

    # Merge river temp with df (daily to hourly)
    df['date'] = df['datetime_stamp_pacific'].dt.date
    river_df['date'] = river_df['Date'].dt.date
    df = df.merge(river_df[['date', 'river_temp_C']], on='date', how='left')
    df.drop(columns=['date'], inplace=True)

    return df, gens, measures, standalone_sensors


def initialize_echarts(start_date, end_date, eChart=None):
    '''Initialize the eChart dict structure'''
    if eChart is None:
        eChart = {}

    if '_yPos' not in eChart:
        start_ts = int(pd.Timestamp(start_date).timestamp() * 1000)
        end_ts = int(pd.Timestamp(end_date).timestamp() * 1000)
        eChart.update({
            '_yPos': 0,
            '_height': '0px',
            '_gridIndex': 0,
            '_axisIndex': 0,
            '_seriesIndex': 0,
            '_start_date': start_ts,
            '_end_date': end_ts,
            '_events': {"click": "function(params) {return [params.name, params.value, params.seriesName]}"},
            'tooltip': {'trigger': 'axis', 'axisPointer': {'type': 'cross', 'label': {'color': '#000000', 'backgroundColor': '#fff'}}},
            'dataZoom': [{"type": "inside", 'filterMode': 'none', "xAxisIndex": []}, {"type": "slider", 'filterMode': 'none', "xAxisIndex": []}],
            'title': [],
            'legend': [],
            'grid': [],
            'yAxis': [],
            'xAxis': [],
            'visualMap': [],
            'series': [],
        })
    return eChart


def make_chart(df, columns, title, timestamp_col, eChart, height=250, limits_df=None, limit_key=None):
    '''
    Generate a line chart for a list of columns.

    Args:
        df: DataFrame with timestamp and data columns
        columns: List of column names to plot
        title: Chart title
        timestamp_col: Name of the timestamp column
        eChart: The eChart dict to append to
        height: Chart height in pixels
        limits_df: DataFrame with min/max limits indexed by measure name
        limit_key: Key to use for looking up limits (defaults to title)
    '''
    yPos = eChart['_yPos']

    # Filter to columns that exist
    existing_cols = [c for c in columns if c in df.columns]
    if not existing_cols:
        return eChart

    # Calculate y-axis range from all series
    all_values = df[existing_cols].values.flatten()
    all_values = all_values[~np.isnan(all_values)]
    if len(all_values) == 0:
        return eChart

    min_value, max_value = all_values.min(), all_values.max()
    dy = max_value - min_value
    min_y = min_value - dy * 0.1 if dy != 0 else min_value - 1.0
    max_y = max_value + dy * 0.1 if dy != 0 else max_value + 1.0
    if max_y == min_y:
        max_y = max_y + 1
    if max_y - min_y > 1:
        max_y = math.ceil(max_y)
        min_y = math.floor(min_y)

    # Add chart components
    eChart['title'].append({"top": f'{yPos}px', "left": '10%', "text": title})
    eChart['legend'].append({'data': [], 'selected': {}, 'type': 'scroll', 'orient': 'vertical', 'right': 10, 'top': f'{yPos}px'})
    eChart['grid'].append({"top": f'{yPos + 25}px', "height": f"{height - 60}px", "tooltip": {"show": True, "trigger": 'axis', 'axisPointer': 'cross'}})
    eChart['yAxis'].append({"type": "value", "gridIndex": eChart['_gridIndex'], "min": min_y, "max": max_y})
    eChart['xAxis'].append({"type": 'time', "gridIndex": eChart['_gridIndex'], "min": eChart['_start_date'], "max": eChart['_end_date']})

    # Y-axis zoom slider
    eChart['dataZoom'].append({"type": "slider", 'filterMode': 'none', "yAxisIndex": eChart['_axisIndex'], "left": "3%"})
    eChart['dataZoom'][0]['xAxisIndex'].append(eChart['_axisIndex'])
    eChart['dataZoom'][1]['xAxisIndex'].append(eChart['_axisIndex'])

    # Convert timestamp to milliseconds
    df_plot = df[[timestamp_col] + existing_cols].copy()
    df_plot['_ts_ms'] = pd.to_datetime(df_plot[timestamp_col]).astype(np.int64) // 10**6

    # Add series for each column
    for col in existing_cols:
        # Use shortened name for generator columns (C-##)
        display_name = col[:4] if col.startswith('C-') else col
        eChart['legend'][eChart['_gridIndex']]['data'].append(display_name)
        eChart['legend'][eChart['_gridIndex']]['selected'][display_name] = True

        series_data = [[ts, None if pd.isna(val) else val] for ts, val in zip(df_plot['_ts_ms'], df_plot[col])]
        eChart['series'].append({
            "type": "line",
            "name": display_name,
            "data": series_data,
            "showSymbol": False,
            "xAxisIndex": eChart['_axisIndex'],
            "yAxisIndex": eChart['_axisIndex'],
            "lineStyle": {"width": 2},
        })
        eChart['_seriesIndex'] += 1

    # Add min/max limit lines if limits_df provided
    lkey = limit_key if limit_key else title
    if limits_df is not None and lkey in limits_df.index:
        min_val = limits_df.loc[lkey, 'min']
        max_val = limits_df.loc[lkey, 'max']
        min_limit = None if pd.isna(min_val) else float(min_val)
        max_limit = None if pd.isna(max_val) else float(max_val)

        mark_data = []
        if min_limit is not None:
            mark_data.append({"yAxis": min_limit, "lineStyle": {"color": "fuchsia", "width": 2, "type": "dashed"}})
        if max_limit is not None:
            mark_data.append({"yAxis": max_limit, "lineStyle": {"color": "red", "width": 2}})

        if mark_data:
            eChart['series'].append({
                "type": "line",
                "name": "Limits",
                "data": [],
                "xAxisIndex": eChart['_axisIndex'],
                "yAxisIndex": eChart['_axisIndex'],
                "markLine": {
                    "silent": True,
                    "symbol": "none",
                    "label": {"show": False},
                    "data": mark_data
                }
            })
            eChart['_seriesIndex'] += 1

    # Update positions
    eChart['_yPos'] += height
    eChart['_axisIndex'] += 1
    eChart['_gridIndex'] += 1
    eChart['_height'] = f"{eChart['_yPos'] + 30}px"

    return eChart


def make_echart(df, gens, measures, timestamp_col='timestamp_utc', height_per_chart=250, limits_df=None, additional_sensors=None):
    '''
    Generate linked echarts for data.

    Args:
        df: DataFrame with timestamp and measurement columns (e.g., C-02_avg_winding_temp(C))
        gens: List of generator prefixes (e.g., ['C-02', 'C-04', 'C-05'])
        measures: List of measures (e.g., ['avg_winding_temp(C)', 'total_current(A)'])
        timestamp_col: Name of the timestamp column
        height_per_chart: Height of each subplot in pixels
        limits_df: DataFrame with min/max limits indexed by measure name
        additional_sensors: Optional dict mapping sensors to measures they should overlay with,
                           or list of sensors to plot separately.
                           Dict example: {'river_temp_C': 'avg_cooling_water_temp(C)'}
                           List example: ['river_temp_C'] - plots as separate chart

    Returns:
        tuple: (eChart dict, total height string)
    '''
    start_date = df[timestamp_col].min()
    end_date = df[timestamp_col].max()

    eChart = initialize_echarts(start_date, end_date)

    # Build overlay mapping: measure -> list of additional sensors
    overlay_map = {}
    standalone_sensors = []

    if additional_sensors:
        if isinstance(additional_sensors, dict):
            # Dict maps sensor -> measure it should overlay
            for sensor, measure in additional_sensors.items():
                if measure in measures:
                    if measure not in overlay_map:
                        overlay_map[measure] = []
                    overlay_map[measure].append(sensor)
                else:
                    standalone_sensors.append(sensor)
        else:
            # List of sensors to plot separately
            standalone_sensors = list(additional_sensors)

    # Plot each measure with its overlays
    for measure in measures:
        # Build column list: gen columns + any overlay sensors
        # Use _avg_ prefix for all measures except total_current(A)
        prefix = '' if measure == 'total_current(A)' else 'avg_'
        columns = [f"{gen}_{prefix}{measure}" for gen in gens]
        if measure in overlay_map:
            columns.extend(overlay_map[measure])
        eChart = make_chart(df, columns, measure, timestamp_col, eChart, height=height_per_chart, limits_df=limits_df, limit_key=measure)

    # Plot standalone sensors
    for sensor in standalone_sensors:
        eChart = make_chart(df, [sensor], sensor, timestamp_col, eChart, height=height_per_chart, limits_df=limits_df)

    return eChart, eChart['_height']


# Keep old name as alias for backwards compatibility
def make_stator_echart(*args, **kwargs):
    return make_echart(*args, **kwargs)


